# ── Environment ──
ENVIRONMENT=development

# ── Database ──
DB_PASS=gradepro_dev_password
DB_PASS_RO=gradepro_readonly_password

# ── Redis ──
REDIS_MAX_MEMORY=512mb

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_ASSIGNMENTS=gradepro-assignments
R2_BUCKET_REPORTS=gradepro-reports
R2_BUCKET_TEMPLATES=gradepro-templates
R2_BUCKET_MODELS=gradepro-models
R2_BUCKET_TRAINING=gradepro-training-data
R2_BUCKET_BACKUPS=gradepro-backups

# ── ML ── (0 = auto calculate 40% of free system RAM)
MODEL_CACHE_MAX_MB=0
MODEL_CACHE_MIN_FREE_MB=300
MODELS_DIR=./models
AI_DETECTION_REFER_THRESHOLD=0.7
PLAGIARISM_REFER_THRESHOLD=20
CELERY_ANALYSIS_CONCURRENCY=1

# ── LLM Reasoning / API ──
LLM_CALL_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_ENDPOINT=http://host.docker.internal:11434

# ── Celery Workers ──
CELERY_GRADING_REPLICAS=2
CELERY_GRADING_CONCURRENCY=15
CELERY_TRAINING_CONCURRENCY=2
CELERY_PDF_CONCURRENCY=10
TRAINING_CPU_LIMIT=1.5

# ── Gotenberg / ClamAV ──
GOTENBERG_MEM_LIMIT=2g
GOTENBERG_QUEUE=5
GOTENBERG_TIMEOUT=30s
CLAMAV_MEM_LIMIT=1g

# ── Monitoring ──
GRAFANA_PASSWORD=admin
